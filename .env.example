# ── piweb docker compose configuration ──

# Where the shared SQLite DB / sessions / media live. MUST be the same absolute
# path the host worker uses (see ~/.config/piweb/config.env) — it is bind-mounted
# into the container at this exact path.
PIWEB_DATA=/home/chihmin/.local/share/piweb

# Shared access token — fallback for access that is NOT behind `tailscale serve`
# (local/dev). Behind serve you can leave this and just use Tailscale identity.
# Generate with: openssl rand -hex 24
WEB_AUTH_TOKEN=

# Public URL, used to reject cross-site state-changing requests (CSRF).
WEB_PUBLIC_ORIGIN=https://piweb.example.ts.net

# Restrict to specific Tailscale logins (comma-separated). Empty = any tailnet
# user who has an identity. Tagged devices have none and are always rejected.
WEB_ALLOWED_LOGINS=

# Tailscale auth key, needed ONLY for the first node registration. Create one at
#   https://login.tailscale.com/admin/settings/keys
# Once ./ts-state holds an authed node, leave this unset.
TS_AUTHKEY=

LOG_LEVEL=info
