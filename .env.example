# Generated by: piscord setup
# Or edit manually. See: piscord help

# Required
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Pi agent configuration
PI_BIN=pi
PI_MODEL=
PI_THINKING=
# Default working directory for pi. Override per channel with:
#   piscord register <id> <name> --cwd /path/to/project
PI_CWD=/home/ubuntu
PI_EXTRA_FLAGS=

# Gateway behavior
TRIGGER_NAME=pi
MAX_CONCURRENCY=3
POLL_INTERVAL_MS=1000
SHUTDOWN_TIMEOUT_MS=15000
# A new message while pi is still working interrupts the in-flight run
# ("pi stop") and processes the new message, replying `interrupt`. Set to
# false to keep the old behaviour (new messages queue and wait).
INTERRUPT_ON_NEW_MESSAGE=true
# Run pi as a persistent `--mode rpc` session per channel. A message arriving
# mid-turn is then STEERED into the running turn (redirect the agent in-flight)
# instead of killing the process. Falls back to print mode for attachments /
# until-done. When off, uses the one-shot print path + kill-based interrupt.
RPC_STEER=false
RPC_IDLE_TIMEOUT_MS=600000
AUTO_REGISTER_DMS=true
# Transcribe Discord voice/audio attachments with the local Breeze ASR HTTP server.
VOICE_ASR_ENABLED=true
VOICE_ASR_URL=http://127.0.0.1:8025
VOICE_ASR_TIMEOUT_MS=30000
VOICE_ASR_RETRIES=1
VOICE_ASR_RETRY_DELAY_MS=10000
MAX_ATTACHMENT_BYTES=26214400
MAX_TOTAL_ATTACHMENT_BYTES=52428800

# Storage examples
# If left unset, the built-in defaults are under ~/.local/share/piscord-gateway/
SESSIONS_DIR=./sessions
DB_PATH=./gateway.db

# Logging
LOG_LEVEL=info
