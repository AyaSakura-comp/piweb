# piweb configuration.
#
# The SAME values are used by both halves:
#   - docker compose reads WEB_AUTH_TOKEN / PIWEB_DATA from a .env next to
#     docker-compose.yml
#   - the host worker reads this file via ~/.config/piweb/config.env
#
# Keep DB_PATH / SESSIONS_DIR / WEB_MEDIA_DIR / WEB_UPLOAD_DIR identical on both
# sides. The web tier records absolute upload paths in SQLite and the host
# worker opens them directly, so a path that differs between container and host
# breaks attachments while leaving text messages working.

# ── shared ──
PIWEB_DATA=/home/chihmin/.local/share/piweb
DB_PATH=/home/chihmin/.local/share/piweb/gateway.db
SESSIONS_DIR=/home/chihmin/.local/share/piweb/sessions
WEB_MEDIA_DIR=/home/chihmin/.local/share/piweb/web-media
WEB_UPLOAD_DIR=/home/chihmin/.local/share/piweb/web-uploads

# ── web tier ──
# Required. Generate with: openssl rand -hex 24
WEB_AUTH_TOKEN=
WEB_PORT=8099

# ── worker (host) ──
PI_BIN=pi
# Default working directory for new sessions; /pi cwd overrides per session.
PI_CWD=/home/chihmin/src
# PI_MODEL=
# PI_THINKING=

# Stream pi's intermediate reasoning/tool calls into the transcript.
STREAM_THINKING=true
STREAM_TOOLS=true

# Persistent RPC session per channel — lets a new message steer a run already
# in flight instead of queueing behind it.
RPC_STEER=false

# Interrupt an in-flight run when a new message arrives.
INTERRUPT_ON_NEW_MESSAGE=true

LOG_LEVEL=info
